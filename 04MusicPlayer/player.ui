   <string notr="true">/* 给主背景设置圆角和深色主题 */
QWidget#MusicPlayer {
    background-color: #1e1e1e;
    color: #ffffff;
    border-radius: 12px;
}

/* 美化进度条 */
QSlider::groove:horizontal {
    height: 4px;
    background: #333;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #0078d4;
    width: 12px;
    margin: -4px 0;
    border-radius: 6px;
}

/* 列表样式 */
QTableWidget {
    background-color: transparent;
    alternate-background-color: #252525;
    gridline-color: transparent;
    border: none;
}
QPushButton {
    border-radius: 5px;
    border: 1px solid #444;
}

QPushButton:hover {
    background-color: #0078d4; /* 蓝色悬停感 */
}</string>
